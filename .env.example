# Server
PORT=3003
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/maavadao

# Redis (optional, for distributed rate limiting)
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=change-this-in-production

# Base URL
BASE_URL=http://localhost:3003

# CORS allowed origins (comma-separated; production only)
# CORS_ALLOWED_ORIGINS=https://www.maavadao.com,https://maavadao.com,https://openclaw.com,https://www.openclaw.com,https://docs.openclaw.ai

# Twitter/X OAuth (for verification)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Cloud Run agent runtime (optional)
# Shared multi-tenant service URL
CLOUD_RUN_SHARED_SERVICE_URL=https://your-shared-service.run.app
# Dedicated: base URL for new-service-per-agent (or leave empty to disable)
CLOUD_RUN_DEDICATED_BASE_URL=https://maava.run.app
DEPLOYER_URL=http://localhost:3002/api/v1

# ── Admin ───────────────────────────────────────────────────────────
# Secret for /api/v1/users/admin/* endpoints (X-Admin-Secret header)
# Generate a strong random value in production: openssl rand -hex 32
ADMIN_SECRET=change-this-admin-secret

# ── Gmail (Nodemailer) ───────────────────────────────────────────────
# Leave blank in development — emails are logged to console, not sent.
# Generate App Password at: https://myaccount.google.com/apppasswords
# (Requires 2FA enabled on your Google account)
GMAIL_USER=yourapp@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   # 16-char App Password

# Product name used in email templates (default: maavaDao)
PRODUCT_NAME=maavaDao